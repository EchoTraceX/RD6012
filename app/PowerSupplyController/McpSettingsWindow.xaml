<Window x:Class="PowerSupplyController.McpSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI / MCP 设置" Width="640" Height="680" MinWidth="570" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" x:Name="SettingsPanel">
            <TextBlock Text="让 AI 使用当前电源连接" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,18"/>
            <CheckBox x:Name="EnabledBox" Content="随上位机启动本机 MCP 服务"/>
            <CheckBox x:Name="AllowControlBox" Content="允许 AI 设置参数及开启 / 关闭输出"/>
            <TextBlock Text="未勾选控制时仅可查询。以下限值只约束 AI；请按实际负载设置。" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="本机端口"/><TextBox x:Name="PortBox"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="AI 最高电压 (V)"/><TextBox x:Name="VoltageBox"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="AI 最大限流 (A)"/><TextBox x:Name="CurrentBox"/></StackPanel>
            </Grid>
            <TextBlock Text="已保存的 MCP 地址 · Streamable HTTP"/>
            <TextBox x:Name="EndpointBox" IsReadOnly="True"/>
            <TextBlock Text="访问令牌 · 配置后请妥善保管"/>
            <PasswordBox x:Name="TokenBox" Padding="8" Margin="0,5,0,12"/>
            <WrapPanel>
                <Button Content="复制令牌" Click="CopyToken_Click"/>
                <Button Content="复制客户端 JSON" Click="CopyConfiguration_Click"/>
                <Button Content="生成新令牌" Click="RotateToken_Click"/>
            </WrapPanel>
            <TextBlock Text="客户端需支持 Streamable HTTP 和 Bearer 请求头。软件关闭后接口停止；关闭服务或撤销 AI 控制不会自动关闭电源输出。" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>
            <TextBlock x:Name="FeedbackText" Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,12"/>
            <WrapPanel>
                <Button Content="保存并应用" Click="Save_Click"/>
                <Button Content="关闭" Click="Close_Click"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
