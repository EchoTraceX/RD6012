<Window x:Class="PowerSupplyController.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示"
        Icon="Assets/AppIcon.ico"
        Width="440"
        Height="250"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Bahnschrift">
    <Grid Background="#05080D">
        <Border Margin="14"
                CornerRadius="22"
                BorderBrush="#27303D"
                BorderThickness="1"
                Background="#10151D">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Color="#CC000000" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0E141C" BorderBrush="#1D2633" BorderThickness="0,0,0,1" Padding="18,14" CornerRadius="22,22,0,0">
                    <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="16" Background="{Binding AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding DialogTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#F4F8FB"/>
                        <Button Grid.Column="2" Width="34" Height="28" Background="#24161A" BorderBrush="#49343A" BorderThickness="1" Click="CloseButton_Click">
                            <Path Stroke="#F4F8FB" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 2 2 L 10 10 M 10 2 L 2 10"/>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="22,18,22,10">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#D6DEE6" FontSize="14" LineHeight="22"/>
                </StackPanel>

                <Border Grid.Row="2" Background="#0E141C" BorderBrush="#1D2633" BorderThickness="0,1,0,0" Padding="18,14" CornerRadius="0,0,22,22">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SecondaryButton" Content="{Binding SecondaryButtonText}" Visibility="Collapsed" Click="SecondaryButton_Click" Margin="0,0,10,0" Padding="16,10" Foreground="#D6DEE6" Background="#1A2330" BorderBrush="#2A3546" BorderThickness="1"/>
                        <Button x:Name="PrimaryButton" Content="{Binding PrimaryButtonText}" Click="PrimaryButton_Click" Padding="16,10" Foreground="#F4F8FB" Background="{Binding AccentBrush}" BorderBrush="{Binding AccentBrush}" BorderThickness="1"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
