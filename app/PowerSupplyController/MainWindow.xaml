<Window x:Class="PowerSupplyController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:PowerSupplyController"
        mc:Ignorable="d"
        Title="RD6012 数控电源上位机"
        Icon="Assets/AppIcon.ico"
        Width="1320"
        Height="900"
        MinWidth="980"
        MinHeight="680"
        FontFamily="Bahnschrift"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 动画资源 -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="PulseAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.6" Duration="0:0:0.15" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="RecordingBlinkAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.8" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryButtonForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>

        <Style x:Key="NeutralButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemeNeutralButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeNeutralButtonBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <Style x:Key="GreenButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemePositiveButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePositiveButtonBorderBrush}"/>
        </Style>

        <Style x:Key="RedButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemeDestructiveButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeDestructiveButtonBorderBrush}"/>
        </Style>

        <Style x:Key="LockToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayData.Lock}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource ThemeWarningButtonBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeWarningButtonBorderBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryButtonForegroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecordToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeDestructiveButtonBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeDestructiveButtonBorderBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryButtonForegroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="ControlTabsStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      Margin="18,18,18,0"
                                      IsItemsHost="True"
                                      Background="Transparent"/>
                            <Border Grid.Row="1"
                                    Margin="0"
                                    Padding="0"
                                    Background="Transparent">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="0"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControlTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="14,8"
                                CornerRadius="12"
                                Background="{DynamicResource ThemeTabBrush}"
                                BorderBrush="{DynamicResource ThemeTabBorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ThemePrimaryButtonBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ThemePrimaryButtonBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource ThemeTitleBarButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeTitleBarButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleBtnBorder" Property="Background" Value="{DynamicResource ThemeTitleBarButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleBtnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemeCloseButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCloseButtonBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBtnBorder" Property="Background" Value="{DynamicResource ThemeCloseButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBtnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBoxStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemeFieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

        <Border x:Name="WindowFrame"
                CornerRadius="16"
                BorderBrush="{DynamicResource BorderBrushStrong}"
                BorderThickness="1"
                Background="{DynamicResource BgBrush}">
        <Border.Effect>
            <DropShadowEffect x:Name="WindowShadowEffect" BlurRadius="20" Color="#000000" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource ThemeWindowTitleBarBrush}" BorderBrush="{DynamicResource ThemeWindowTitleBarBorderBrush}" BorderThickness="0,0,0,1" Padding="22,18,18,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="52" Height="52" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource ThemeHeaderIconOuterBrush}" Stroke="{DynamicResource ThemeHeaderIconOuterBorderBrush}" StrokeThickness="1.5"/>
                            <Ellipse Width="26" Height="26" Fill="{DynamicResource ThemeHeaderIconInnerBrush}"/>
                            <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 14 31 C 21 15, 31 15, 38 31"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="RD6012 Power Desk" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{DynamicResource ThemeStatusBadgeBrush}" BorderBrush="{DynamicResource ThemeStatusBadgeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ConnectionIndicator" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#FF6B6B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                            <Setter Property="Fill" Value="#4FD28E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource ThemeStatusBadgeBrush}" BorderBrush="{DynamicResource ThemeStatusBadgeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding DisplayData.SerialNumberDisplay, StringFormat=序列号 {0}, TargetNullValue='序列号 --', FallbackValue='序列号 --'}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Border Background="{DynamicResource ThemeStatusBadgeBrush}" BorderBrush="{DynamicResource ThemeStatusBadgeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding RefreshRate, StringFormat=刷新率 {0:F1} Hz}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Button x:Name="McpButton" Content="AI / MCP" Margin="12,0,0,0" Padding="10,4" Style="{StaticResource NeutralButtonStyle}" Click="McpButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="配置 AI 的本机 MCP 接口"/>
                                <TextBlock Text="{Binding SampleStatusText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                            <ComboBox Width="150"
                                      Margin="0,0,10,0"
                                      ItemsSource="{Binding LayoutOptions}"
                                      SelectedItem="{Binding SelectedLayoutOption}"
                                      DisplayMemberPath="DisplayName"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button Content="⚙ 串口设置" Style="{StaticResource NeutralButtonStyle}" Padding="14,8" Margin="0,0,10,0" Click="SettingsButton_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button Content="📁 记录文件" Style="{StaticResource NeutralButtonStyle}" Padding="14,8" Margin="0,0,10,0" Click="OpenRecordsFolderButton_Click" ToolTip="打开CSV记录文件夹" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button Content="{Binding ThemeButtonText}" Style="{StaticResource NeutralButtonStyle}" Padding="14,8" Margin="0,0,10,0" Click="ThemeToggleButton_Click" ToolTip="切换浅色/深色主题" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <Button Style="{StaticResource TitleButtonStyle}" Click="MinimizeButton_Click">
                                <Rectangle Width="12" Height="1.6" Fill="{DynamicResource TitleBrush}"/>
                            </Button>
                            <Button Style="{StaticResource TitleButtonStyle}" Click="MaximizeRestoreButton_Click">
                                <Grid Width="14" Height="14">
                                    <Border x:Name="MaximizeIcon" BorderBrush="{DynamicResource TitleBrush}" BorderThickness="1.4"/>
                                    <Grid x:Name="RestoreIcon" Visibility="Collapsed">
                                        <Border Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="{DynamicResource TitleBrush}" BorderThickness="1.2"/>
                                        <Border Width="9" Height="9" Margin="0,0,3,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{DynamicResource ThemeWindowTitleBarBrush}" BorderBrush="{DynamicResource TitleBrush}" BorderThickness="1.2"/>
                                    </Grid>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource CloseTitleButtonStyle}" Click="CloseButton_Click">
                                <Path Stroke="{DynamicResource TitleBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 2 2 L 12 12 M 12 2 L 2 12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="22,18,22,12" Visibility="{Binding IsClassicLayout, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="输出电压" Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
                    <TextBlock x:Name="VoltageDisplay" Margin="0,10,0,2" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}">
                        <Run Text="{Binding DisplayData.VoltageOut, StringFormat=F2, TargetNullValue=--, FallbackValue=--}"/><Run Text=" V" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding AppliedVoltageText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="输出电流" Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
                    <TextBlock x:Name="CurrentDisplay" Margin="0,10,0,2" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}">
                        <Run Text="{Binding DisplayData.CurrentOut, StringFormat=F3, TargetNullValue=--, FallbackValue=--}"/><Run Text=" A" FontSize="18" Foreground="{DynamicResource SuccessBrush}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding AppliedCurrentText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource PanelStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="输出功率" Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
                    <TextBlock x:Name="PowerDisplay" Margin="0,10,0,2" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}">
                        <Run Text="{Binding DisplayData.PowerOut, StringFormat=F2, TargetNullValue=--, FallbackValue=--}"/><Run Text=" W" FontSize="18" Foreground="{DynamicResource WarnBrush}"/>
                    </TextBlock>
                    <TextBlock Text="根据实时电压与电流计算" Foreground="{DynamicResource MutedBrush}" FontSize="11" Opacity="0.8"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource PanelStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="输入电压" Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
                    <TextBlock Margin="0,10,0,2" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}">
                        <Run Text="{Binding DisplayData.VoltageIn, StringFormat=F2, TargetNullValue=--, FallbackValue=--}"/><Run Text=" V" FontSize="18" Foreground="{DynamicResource MutedBrush}"/>
                    </TextBlock>
                    <TextBlock Text="设备侧输入端电压" Foreground="{DynamicResource MutedBrush}" FontSize="11" Opacity="0.8"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="22,0,22,22" Visibility="{Binding IsClassicLayout, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <TabControl Style="{StaticResource ControlTabsStyle}" ItemContainerStyle="{StaticResource ControlTabItemStyle}">
                    <TabItem Header="概览">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="产品型号" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding DisplayData.ProductModelDisplay, TargetNullValue=--, FallbackValue=--}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <TextBlock Text="固件版本" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding DisplayData.FirmwareVersionDisplay, TargetNullValue=--, FallbackValue=--}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="序列号" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding DisplayData.SerialNumberDisplay, TargetNullValue=--, FallbackValue=--}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1">
                                                <TextBlock Text="系统温度" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding DisplayData.TemperatureDisplay, TargetNullValue=--, FallbackValue=--}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="4" Grid.Column="0">
                                                <TextBlock Text="串口" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Config.PortName}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="4" Grid.Column="1">
                                                <TextBlock Text="波特率" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Config.BaudRate}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="6" Grid.Column="0">
                                                <TextBlock Text="设备地址" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding Config.DeviceAddress}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="6" Grid.Column="1">
                                                <TextBlock Text="输出状态" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                <TextBlock Text="{Binding DisplayData.OutputStatus, TargetNullValue=--, FallbackValue=--}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                            <Border Grid.Row="2" Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="操作建议" Style="{StaticResource SectionTitleStyle}" FontSize="16"/>
                                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Text="需要重新选择串口或设备地址时，使用顶部的“串口设置”。设定页可联动调整电压和电流，输出开关移动到了曲线区顶部，方便直接操作。"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                    <TabItem Header="设定">
                                <StackPanel Margin="18">
                                    <TextBlock Text="电压 / 电流联调" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Margin="0,6,0,14" Foreground="{DynamicResource MutedBrush}" FontSize="13" Text="按厂家寄存器同时写入电压与电流，便于一起调节。"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="目标电压" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                                            <TextBox x:Name="VoltageSetText" Text="{Binding VoltageSetValue, StringFormat=F2, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="目标电流" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                                            <TextBox x:Name="CurrentSetText" Text="{Binding CurrentSetValue, StringFormat=F3, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="应用设定" Style="{StaticResource BaseButtonStyle}" Margin="0,14,0,18" Click="ApplySettingsButton_Click" IsEnabled="{Binding IsDeviceDataValid}"/>
                                    <TextBlock Text="电压预设" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="3.3V" Tag="3.3" Style="{StaticResource PresetButtonStyle}" Width="72" Click="PresetButton_Click"/>
                                        <Button Content="5V" Tag="5" Style="{StaticResource PresetButtonStyle}" Width="72" Click="PresetButton_Click"/>
                                        <Button Content="12V" Tag="12" Style="{StaticResource PresetButtonStyle}" Width="72" Click="PresetButton_Click"/>
                                        <Button Content="24V" Tag="24" Style="{StaticResource PresetButtonStyle}" Width="72" Click="PresetButton_Click"/>
                                        <Button Content="48V" Tag="48" Style="{StaticResource PresetButtonStyle}" Width="72" Click="PresetButton_Click"/>
                                    </WrapPanel>
                                    <TextBlock Text="电流预设" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Content="0.5A" Tag="0.5" Style="{StaticResource PresetButtonStyle}" Width="72" Click="CurrentPresetButton_Click"/>
                                        <Button Content="1A" Tag="1.0" Style="{StaticResource PresetButtonStyle}" Width="72" Click="CurrentPresetButton_Click"/>
                                        <Button Content="2A" Tag="2.0" Style="{StaticResource PresetButtonStyle}" Width="72" Click="CurrentPresetButton_Click"/>
                                        <Button Content="3A" Tag="3.0" Style="{StaticResource PresetButtonStyle}" Width="72" Click="CurrentPresetButton_Click"/>
                                        <Button Content="5A" Tag="5.0" Style="{StaticResource PresetButtonStyle}" Width="72" Click="CurrentPresetButton_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </TabItem>

                    <TabItem Header="常用预设">
                                <StackPanel Margin="18">
                                    <TextBlock Text="常用预设" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Margin="0,6,0,14" Foreground="{DynamicResource MutedBrush}" FontSize="13" Text="先选择预设并检查待应用数值，再点击应用；输出开启时会再次确认。"/>
                                    <TextBlock Text="{Binding PendingSetpointsText}" Foreground="{DynamicResource AccentBrush}" FontSize="14" Margin="0,0,0,12"/>
                                    <Button Content="应用选中设定" Style="{StaticResource BaseButtonStyle}" Click="ApplySettingsButton_Click" IsEnabled="{Binding IsDeviceDataValid}" Margin="0,0,0,14"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="1.8V / 0.5A" Tag="低压测试" Style="{StaticResource PresetButtonStyle}" Click="CommonPresetButton_Click"/>
                                            <Button Grid.Column="2" Content="3.3V / 1A" Tag="单片机" Style="{StaticResource PresetButtonStyle}" Click="CommonPresetButton_Click"/>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="5V / 2A" Tag="USB 设备" Style="{StaticResource PresetButtonStyle}" Click="CommonPresetButton_Click"/>
                                            <Button Grid.Column="2" Content="9V / 2A" Tag="快充协议" Style="{StaticResource PresetButtonStyle}" Click="CommonPresetButton_Click"/>
                                        </Grid>
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="12V / 1A" Tag="12V 轻载" Style="{StaticResource PresetButtonStyle}" Click="CommonPresetButton_Click"/>
                                            <Button Grid.Column="2" Content="12V / 3A" Tag="常用供电" Style="{StaticResource PresetButtonStyle}" Click="CommonPresetButton_Click"/>
                                        </Grid>
                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="15V / 2A" Tag="风扇/电机" Style="{StaticResource PresetButtonStyle}" Click="CommonPresetButton_Click"/>
                                            <Button Grid.Column="2" Content="19V / 3A" Tag="19V 设备" Style="{StaticResource PresetButtonStyle}" Click="CommonPresetButton_Click"/>
                                        </Grid>
                                        <Grid Grid.Row="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="24V / 2A" Tag="工控 24V" Style="{StaticResource PresetButtonStyle}" Click="CommonPresetButton_Click"/>
                                            <Button Grid.Column="2" Content="48V / 0.5A" Tag="高压待机" Style="{StaticResource PresetButtonStyle}" Click="CommonPresetButton_Click"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="电压 · 电流 · 功率趋势" Style="{StaticResource SectionTitleStyle}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="开启输出" Style="{StaticResource GreenButtonStyle}" Width="95" Margin="0,0,10,0" Click="EnableOutputButton_Click" IsEnabled="{Binding CanEnableOutput}" ToolTip="按当前设备设定开启输出"/>
                                    <Button Content="关闭输出" Style="{StaticResource RedButtonStyle}" Width="95" Margin="0,0,10,0" Click="DisableOutputButton_Click" IsEnabled="{Binding CanDisableOutput}" ToolTip="关闭电源输出"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                        <Button Content="{Binding RecordButtonText}" Style="{StaticResource RecordToggleButtonStyle}" Width="110" Click="RecordButton_Click" ToolTip="开始/停止记录数据到CSV文件"/>
                                        <Ellipse x:Name="RecordingIndicator" Width="8" Height="8" Fill="#FF6B6B" Margin="8,0,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Button x:Name="ChartPauseButton" Content="⏸ 波形暂停" Style="{StaticResource NeutralButtonStyle}" Width="110" Margin="0,0,10,0" Click="ChartPauseButton_Click" ToolTip="暂停/恢复波形更新"/>
                                    <Button Content="🗑 波形清空" Style="{StaticResource NeutralButtonStyle}" Width="110" Click="ClearChartButton_Click" ToolTip="清空历史波形数据"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Grid.Row="1" Margin="0,18,0,18">
                                <Button Content="{Binding LockButtonText}" Style="{StaticResource LockToggleButtonStyle}" Width="110" Margin="0,0,10,10" Click="LockButton_Click" IsEnabled="{Binding IsDeviceDataValid}" ToolTip="切换键盘锁 (快捷键: Ctrl+L)"/>
                                <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Text="模式" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding DisplayData.CvCcMode, TargetNullValue=--, FallbackValue=--}" Margin="10,0,0,0" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Text="输出" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding DisplayData.OutputStatus, TargetNullValue=--, FallbackValue=--}" Margin="10,0,0,0" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Text="保护" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding DisplayData.ProtectStatus, TargetNullValue=--, FallbackValue=--}" Margin="10,0,0,0" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Text="键盘锁" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding DisplayData.LockStatus, TargetNullValue=--, FallbackValue=--}" Margin="10,0,0,0" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Text="历史电压" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding MaxVoltage, StringFormat=最大 {0:F2}V}" Margin="10,0,0,0" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Text="历史电流" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding MaxCurrent, StringFormat=最大 {0:F3}A}" Margin="10,0,0,0" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Text="历史功率" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding MaxPower, StringFormat=最大 {0:F2}W}" Margin="10,0,0,0" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                            </WrapPanel>
                            <Border Grid.Row="2" Background="{DynamicResource ThemeChartBrush}" BorderBrush="{DynamicResource ThemeChartBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="14">
                                <lvc:CartesianChart x:Name="Chart" Background="{DynamicResource ThemeChartBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

            <Grid Grid.Row="1" Grid.RowSpan="2" Margin="22,18,22,22" Visibility="{Binding IsHtmlLayout, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="实时监测" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{Binding SampleStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Margin="0,6,0,16" Foreground="{DynamicResource MutedBrush}" FontSize="13" Text="设备实测值与设定值"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="输出电压" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                        <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}">
                                            <Run Text="{Binding DisplayData.VoltageOut, StringFormat=F2, TargetNullValue=--, FallbackValue=--}"/><Run Text=" V" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding AppliedVoltageText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="输出电流" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                        <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}">
                                            <Run Text="{Binding DisplayData.CurrentOut, StringFormat=F3, TargetNullValue=--, FallbackValue=--}"/><Run Text=" A" FontSize="18" Foreground="{DynamicResource WarnBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding AppliedCurrentText}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="输出功率" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                        <TextBlock FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}">
                                            <Run Text="{Binding DisplayData.PowerOut, StringFormat=F2, TargetNullValue=--, FallbackValue=--}"/><Run Text=" W" FontSize="18" Foreground="{DynamicResource SuccessBrush}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="输入电压" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding DisplayData.VoltageIn, StringFormat={}{0:F2} V, TargetNullValue='-- V', FallbackValue='-- V'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="系统温度" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding DisplayData.TemperatureDisplay, TargetNullValue=--, FallbackValue=--}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="型号" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding DisplayData.ProductModelDisplay, TargetNullValue=--, FallbackValue=--}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}"/></StackPanel>
                                    <StackPanel Grid.Column="3"><TextBlock Text="固件" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding DisplayData.FirmwareVersionDisplay, TargetNullValue=--, FallbackValue=--}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TitleBrush}"/></StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,18,0,0">
                                    <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Text="模式" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding DisplayData.CvCcMode, TargetNullValue=--, FallbackValue=--}" Margin="10,0,0,0" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                                    <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Text="输出" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding DisplayData.OutputStatus, TargetNullValue=--, FallbackValue=--}" Margin="10,0,0,0" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                                    <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Text="保护" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding DisplayData.ProtectStatus, TargetNullValue=--, FallbackValue=--}" Margin="10,0,0,0" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                                    <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,10"><StackPanel Orientation="Horizontal"><TextBlock Text="键盘锁" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding DisplayData.LockStatus, TargetNullValue=--, FallbackValue=--}" Margin="10,0,0,0" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="输出设定" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Margin="0,6,0,16" Foreground="{DynamicResource MutedBrush}" FontSize="13" Text="{Binding LayoutDescription}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="电压设置 (V)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                                        <Border Background="{DynamicResource ThemeFieldBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16,8">
                                            <TextBox x:Name="HtmlVoltageSetText" BorderThickness="0" Background="Transparent" Padding="0" Text="{Binding VoltageSetValue, StringFormat=F2, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="电流设置 (A)" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                                        <Border Background="{DynamicResource ThemeFieldBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16,8">
                                            <TextBox x:Name="HtmlCurrentSetText" BorderThickness="0" Background="Transparent" Padding="0" Text="{Binding CurrentSetValue, StringFormat=F3, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding PendingSetpointsText}" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="0,12,0,0"/>
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="常用预设" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                                        <ComboBox Width="220" ItemsSource="{Binding PresetProfiles}" SelectedItem="{Binding SelectedPresetProfile}" DisplayMemberPath="DisplayName"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="填入设定" Style="{StaticResource NeutralButtonStyle}" Width="96" Margin="12,24,0,0" Click="ApplySelectedPresetButton_Click" ToolTip="只填入待应用数值，不写入设备"/>
                                </Grid>
                                <WrapPanel Margin="0,18,0,0">
                                    <Button Content="应用设定" Style="{StaticResource BaseButtonStyle}" Width="118" Margin="0,0,10,10" Click="ApplySettingsButton_Click" IsEnabled="{Binding IsDeviceDataValid}" ToolTip="应用电压和电流设定值"/>
                                    <Button Content="🔄 刷新读数" Style="{StaticResource NeutralButtonStyle}" Width="118" Margin="0,0,10,10" Click="RefreshButton_Click" ToolTip="手动刷新当前读数"/>
                                    <Button Content="开启输出" Style="{StaticResource GreenButtonStyle}" Width="118" Margin="0,0,10,10" Click="EnableOutputButton_Click" IsEnabled="{Binding CanEnableOutput}" ToolTip="按当前设备设定开启输出"/>
                                    <Button Content="关闭输出" Style="{StaticResource RedButtonStyle}" Width="118" Margin="0,0,10,10" Click="DisableOutputButton_Click" IsEnabled="{Binding CanDisableOutput}" ToolTip="关闭电源输出"/>
                                    <Button Content="{Binding LockButtonText}" Style="{StaticResource LockToggleButtonStyle}" Width="118" Margin="0,0,10,10" Click="LockButton_Click" IsEnabled="{Binding IsDeviceDataValid}" ToolTip="切换键盘锁"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="22" MinHeight="270">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="电压 · 电流 · 功率趋势" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="13" Text="三项同步显示在同一张图中"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,0"><TextBlock Text="电压" Foreground="{DynamicResource AccentBrush}"/></Border>
                                    <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,0"><TextBlock Text="电流" Foreground="{DynamicResource SuccessBrush}"/></Border>
                                    <Border Background="{DynamicResource ThemeInfoCardBrush}" BorderBrush="{DynamicResource ThemeInfoCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8"><TextBlock Text="功率" Foreground="{DynamicResource WarnBrush}"/></Border>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Margin="0,18,0,0" Background="{DynamicResource ThemeChartBrush}" BorderBrush="{DynamicResource ThemeChartBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="14">
                                <lvc:CartesianChart x:Name="HtmlChart" Background="{DynamicResource ThemeChartBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Window>

